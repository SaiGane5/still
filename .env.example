# Server-side only. Never prefix with NEXT_PUBLIC_.
# Neon: use the *pooled* connection string (host contains "-pooler") with sslmode=require.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Signs guest-session cookies. Required in production (>= 32 random chars).
AUTH_SECRET=

# Optional: when set, `Authorization: Bearer <HS256 JWT>` from your identity provider is
# accepted and its `sub` claim becomes the user identity (see src/server/auth.ts).
AUTH_JWT_SECRET=

# Seed demo tasks for brand-new users (local demos only).
STILL_SEED_DEMO=0
